{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/api/index.php"
    },
    {
      "src": "/ads.txt",
      "dest": "/api/index.php"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/index.php"
    },
    {
      "src": "/(google[a-zA-Z0-9_-]+\\.html)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
