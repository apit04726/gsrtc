# Apache Configuration for ગુજરાત બસ માર્ગદર્શક
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /web/gsrtc/

    # Allow direct access to existing files & directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Handle Sitemap explicitly
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Route all other requests to front-controller index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Block direct access to sensitive data files
<FilesMatch "\.(json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
